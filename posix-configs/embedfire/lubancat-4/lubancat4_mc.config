#!/bin/sh
#
# Multicopter startup for the original EmbedFire LubanCat-4 (not 4-V1).
#------------------------------------------------------------------------------

# PX4 commands need the px4- prefix when executed by the host shell.
. px4-alias.sh

# LR900 telemetry on native UART9-M2: board TX pin 35, RX pin 22.
TELEMETRY_DEVICE=/dev/ttyS9
TELEMETRY_BAUD=57600
TELEMETRY_RATE=1200

# MTF-01P flow/range on UART7-M1: board TX pin 37, RX pin 16 (not 15).
FLOW_DEVICE=/dev/ttyS7
FLOW_BAUD=115200
FLOW_RATE=1000

param select parameters.bson
param import

. ./etc/init.d/rc.board_defaults

# Generic quadrotor X. Keep the current configuration after first setup.
param set SYS_AUTOCONFIG 0
param set MAV_TYPE 2
param set SYS_AUTOSTART 4001

dataman start
load_mon start
battery_status start

. ./etc/init.d/rc.board_sensors
. ./etc/init.d/rc.board_extras

manual_control start
sensors start
commander start
navigator start
ekf2 start
land_detector start multicopter
mc_hover_thrust_estimator start
flight_mode_manager start
mc_pos_control start
mc_att_control start
mc_rate_control start
control_allocator start

# Broadcast MAVLink to the LAN for QGroundControl discovery.
mavlink start -x -u 14556 -r 1000000 -p

# Native TTL UART, no CH340 and no RTS/CTS wires. Keep the LR900 stream
# budget below the radio's over-the-air throughput, not just the UART baud.
if [ -c "$TELEMETRY_DEVICE" ]
then
	if ! mavlink start -Z -d "$TELEMETRY_DEVICE" -b "$TELEMETRY_BAUD" -r "$TELEMETRY_RATE"
	then
		echo "LR900 telemetry failed to start on $TELEMETRY_DEVICE"
	fi
else
	echo "LR900 telemetry device $TELEMETRY_DEVICE not found"
fi

# Reuse the MAVLink receiver's OPTICAL_FLOW_RAD and DISTANCE_SENSOR paths.
# Custom mode still sends the standard 1 Hz heartbeat (for AUTO detection)
# but does not echo high-rate flight/flow streams back to the sensor.
# Forwarding and RTS/CTS remain off; this is not another ground-station link.
if [ -c "$FLOW_DEVICE" ]
then
	if ! mavlink start -Z -d "$FLOW_DEVICE" -b "$FLOW_BAUD" -r "$FLOW_RATE" -m custom
	then
		echo "MTF-01P flow/range failed to start on $FLOW_DEVICE"
	fi
else
	echo "MTF-01P flow/range device $FLOW_DEVICE not found"
fi

logger start -t -b 200
mavlink boot_complete
