#!/bin/sh
#
# EmbedFire LubanCat RK3588 prototype sensor and actuator initialization.
#------------------------------------------------------------------------------

# ICM42688P on SPI bus 0, chip select 0 (/dev/spidev0.0), no board rotation.
if ! icm42688p start -s -b 0 -c 0 -R 0
then
	echo "ICM42688P not found on /dev/spidev0.0"
fi

# MS5611 on I2C bus 2, verified at address 0x77.
if ! ms5611 start -X -b 2 -a 0x77
then
	echo "MS5611 not found on /dev/i2c-2 address 0x77"
fi

# QMC5883L inside the MG-902 on I2C bus 8, address 0x0d. Rotation 2 is
# YAW_90, as required when the MG-902 arrow is mounted pointing forward.
if ! qmc5883l start -X -b 8 -a 0x0d -R 2
then
	echo "MG-902 QMC5883L not found on /dev/i2c-8 address 0x0d"
fi

# MicoAir MG-902 GNSS on UART3, factory configured for UBX NAV-PVT at 115200.
if [ -c /dev/ttyS3 ]
then
	if ! gps start -d /dev/ttyS3 -b 115200 -p ubx
	then
		echo "MG-902 GPS failed to start on /dev/ttyS3"
	fi
else
	echo "MG-902 GPS device /dev/ttyS3 not found"
fi

# Keep actuator traffic on a separate I2C controller.
if ! pca9685_pwm_out start -b 4 -a 0x40
then
	echo "PCA9685 not found on /dev/i2c-4 address 0x40"
fi
