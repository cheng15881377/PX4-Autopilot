#!/bin/sh
#
# EmbedFire LubanCat RK3588 prototype receiver initialization.
#------------------------------------------------------------------------------

# ExpressLRS receiver using bidirectional CRSF on UART1 (/dev/ttyS1).
if [ -c /dev/ttyS1 ]
then
	crsf_rc start -d /dev/ttyS1
else
	echo "CRSF input device /dev/ttyS1 not found"
fi

rc_update start
