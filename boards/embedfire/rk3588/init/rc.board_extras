#!/bin/sh
#
# EmbedFire LubanCat RK3588 prototype runtime initialization.
#------------------------------------------------------------------------------

# ExpressLRS receiver moved to UART3 (/dev/ttyS3, physical header pins 3/5)
# because UART1 is now used by the MG-A01 GNSS.
if [ -c /dev/ttyS3 ]
then
	crsf_rc start -d /dev/ttyS3
else
	echo "CRSF input device /dev/ttyS3 not found"
fi

rc_update start
