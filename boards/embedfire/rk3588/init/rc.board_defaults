#!/bin/sh
#
# EmbedFire LubanCat RK3588 prototype defaults.
#------------------------------------------------------------------------------

# The ICM42688P provides only accelerometer and gyroscope data. Disable the
# magnetometer and barometer requirements until separate sensors are fitted.
param set-default SYS_HAS_MAG 0
param set-default SYS_HAS_BARO 0
param set-default EKF2_MAG_TYPE 5

# PCA9685 defaults: /dev/i2c-4, address 0x40.
param set-default PCA9685_EN_BUS 4
param set-default PCA9685_I2C_ADDR 64
